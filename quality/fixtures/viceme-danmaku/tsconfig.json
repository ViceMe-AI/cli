{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".generated/**/*.ts",
    ".generated/**/*.tsx",
    "src/**/*.tsx",
    "setup-tests.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
