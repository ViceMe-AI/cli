{
  "source": {
    "page": "https://www.loom.com/community/how-to-interact-with-a-video",
    "embed": "https://www.loom.com/embed/9be5bf7764a94315bd44f1b0747abf37",
    "capturedAt": "2026-08-18",
    "method": "Chrome DevTools MCP computed styles + rAF sampling",
    "fullTooltipSpec": "./loom-reaction-tooltip-spec.json"
  },
  "tooltipHover": {
    "wrapClass": "css-1tj5x1a",
    "hiddenClass": "css-3ml681",
    "boxClass": "css-1se974d",
    "behavior": "Show/hide via display none↔block. Opacity stays 1. Transform stays none. Tooltip is a child of the emoji wrapper so it rides scale(1.3) translateY(-6px) rotate(Ndeg).",
    "wrapTransition": "opacity 150ms 50ms",
    "wrapTransformOnHover": "none",
    "boxTransformOnHover": "none",
    "boxAnimationOnHover": "none",
    "layout": {
      "padding": "7px 12px",
      "radius": "6px",
      "background": "#292A2E",
      "shadow": "0 4px 10px rgba(0,0,0,0.1)",
      "top": "-38px",
      "gapAboveButtonPx": 4,
      "label": "12px/18px weight 653 white padding-top 2px",
      "shortcutChip": "rgba(11,18,14,0.14) radius 3px padding 0 4px color #DDDEE1"
    }
  },
  "emojiHover": {
    "animatedElement": "emoji-reaction-set_emojiBtnWrapper_LT2",
    "transition": "transform 0.1s ease-in-out",
    "easingBezier": "cubic-bezier(0.42, 0, 0.58, 1)",
    "fill": "backwards",
    "sameFrameSwitchScaleSum": 2.3,
    "hoverInDurationMs": 100,
    "hoverOutDurationMs": 100,
    "inlineTransform": "scale(1.3) translate(0px, -6px) rotate(Ndeg)",
    "transformOrigin": "16px 16px",
    "rotateN": "random integer each hover, observed -5..5 deg",
    "steadyTranslateYPx": -7.8,
    "note": "Do not use a fixed per-emoji matrix. Rotate is re-rolled on every pointerenter."
  },
  "emojiFlyOnSend": {
    "animationName": "animation-1yp4gtl",
    "hostClass": "css-1hs3ddr",
    "durationMs": 1200,
    "timingFunction": "cubic-bezier(1, 0, 0, 1)",
    "note": "Bounce/scale keyframes apply to flying emoji after send, NOT tooltip hover",
    "keyframes": {
      "0%": { "transform": "translateY(0) scale(0.4) rotate(30deg)", "opacity": 0 },
      "22.5%": { "transform": "translateY(-15px) scale(1.8) rotate(-10deg)", "opacity": 1 },
      "45%": { "transform": "translateY(2px) rotate(15deg)" },
      "53.8922%": { "transform": "translateY(-1px) rotate(-2deg)" },
      "60%": { "transform": "translateY(0) scale(1)", "opacity": 1 },
      "100%": { "opacity": 1 }
    }
  },
  "implementation": {
    "tooltipHover": "Mount/display toggle. No WAAPI on the chip. Keep tooltip inside the emoji transform wrapper.",
    "emojiHover": "CSS transform 100ms ease-in-out; scale(1.3) translate(0,-6px) rotate(random -5..5deg)",
    "emojiFly": "WAAPI playReactionEmojiFlyMotion on send only"
  }
}
